# Arquivo de configurações do backend (exemplo)
# Copie este arquivo para .env e customize conforme necessário

# Database
DATABASE_URL=sqlite:///./app.db

# Security - MUDE ISTO EM PRODUÇÃO!
SECRET_KEY=sua-chave-secreta-muito-segura-alterar-em-producao
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Claude API - obrigatório para o chat responder às perguntas
# Gere sua chave em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-sua-chave-aqui
# Modelo usado nas respostas. Para reduzir custo em testes, troque para
# claude-haiku-4-5 (mais rápido e mais barato, qualidade menor).
CLAUDE_MODEL=claude-opus-5

# Documentos e RAG
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K_CHUNKS=5

# API
API_TITLE=Chat com Documentos (RAG)
API_VERSION=1.0.0
API_DESCRIPTION=API com autenticação JWT e chat com documentos via IA (RAG + Claude)

# CORS - Adicione as origens permitidas
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000

# Logging
LOG_LEVEL=info

# Database - Para produção com PostgreSQL
# DATABASE_URL=postgresql://user:password@localhost:5432/database_name
