# Arquivo de configurações do backend (exemplo)
# Copie este arquivo para .env e customize conforme necessário

# Database
DATABASE_URL=sqlite:///./app.db

# Security - MUDE ISTO EM PRODUÇÃO!
SECRET_KEY=sua-chave-secreta-muito-segura-alterar-em-producao
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API
API_TITLE=Sistema de Cadastro e Funcionalidades
API_VERSION=1.0.0
API_DESCRIPTION=API com autenticação JWT e funcionalidades integrais

# CORS - Adicione as origens permitidas
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000

# Logging
LOG_LEVEL=info

# Database - Para produção com PostgreSQL
# DATABASE_URL=postgresql://user:password@localhost:5432/database_name
